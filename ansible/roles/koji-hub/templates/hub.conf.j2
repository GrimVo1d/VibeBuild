# Managed by Ansible
[hub]
DBName = {{ postgresql_db }}
DBUser = {{ postgresql_user }}
DBPass = {{ postgresql_password }}
DBHost = 127.0.0.1

KojiDir = /mnt/koji

DNUsernameComponent = CN
# The web UI logs users in with its own certificate on their behalf
ProxyDNs = CN=kojiweb,O={{ koji_cert_org }}
LoginCreatesUser = On

KojiWebURL = {{ koji_web_url }}
