# Managed by Ansible; replaces the file from mod_ssl
Listen 443 https

SSLPassPhraseDialog exec:/usr/libexec/httpd-ssl-pass-dialog
SSLSessionCache shmcb:/run/httpd/sslcache(512000)
SSLSessionCacheTimeout 300
SSLCryptoDevice builtin

<VirtualHost _default_:443>
    ServerName {{ koji_hub_fqdn }}:443

    ErrorLog logs/ssl_error_log
    TransferLog logs/ssl_access_log
    LogLevel warn

    SSLEngine on
    SSLCertificateFile {{ koji_pki_dir }}/kojihub.crt
    SSLCertificateKeyFile {{ koji_pki_dir }}/kojihub.key
    SSLCACertificateFile {{ koji_pki_dir }}/koji_ca_cert.crt

    # A client certificate is optional for the connection; the hub and the web UI
    # require one where a login needs it
    SSLVerifyClient optional
    SSLVerifyDepth 10
    SSLOptions +StdEnvVars +ExportCertData
</VirtualHost>

# Plain HTTP only redirects: the hub, the web UI and /kojifiles are served over TLS.
# Redirect is applied before the server-wide Alias directives, so nothing leaks on port 80.
<VirtualHost *:80>
    ServerName {{ koji_hub_fqdn }}
    Redirect permanent / https://{{ koji_hub_fqdn }}/
</VirtualHost>
