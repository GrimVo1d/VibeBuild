# Managed by Ansible
[kojid]
server = {{ koji_hub_url }}
topurl = {{ koji_files_url }}
topdir = /mnt/koji

cert = {{ koji_pki_dir }}/{{ koji_builder_host }}.pem
serverca = {{ koji_pki_dir }}/koji_ca_cert.crt

mockuser = kojibuilder

# No SCM builds: vibebuild uploads SRPMs
allowed_scms =

from_addr = Koji Build System <koji@{{ koji_hub_fqdn }}>
